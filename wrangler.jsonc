{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "margiqo",
  "compatibility_date": "2026-09-11",
  // The site is served from its custom domain (margiqo.com). Leaving the
  // *.workers.dev subdomain live too would publish a second, fully crawlable
  // copy of every page — duplicate content pointing at the same canonical.
  "workers_dev": false,
  "main": "src/worker.js",
  "assets": {
    "directory": "public",
    // Lets src/worker.js fall through to env.ASSETS.fetch(request) for every
    // path except /api/early-access.
    "binding": "ASSETS"
  },
  "kv_namespaces": [
    {
      "binding": "EARLY_ACCESS_KV",
      "id": "c56041dcc5e64fa0b252a92618e512fb"
    }
  ]
}
